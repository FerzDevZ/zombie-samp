# Repo ini sengaja menyimpan SELURUH artefak proyek (plugin, dependency,
# data ColAndreas, runtime, log, backup) supaya bisa dijalankan tanpa langkah
# tambahan. Tidak ada pengecualian besar di sini.
#
# Yang tetap diabaikan hanya sampah proses yang berubah tiap detik dan bukan
# bagian dari hasil kerja:
*.pid
*.core

# Rahasia lokal saja. Bukan artefak, jadi tidak ikut kebijakan
# "simpan seluruh artefak". Dibuat dari scriptfiles/mysql.ini.
.env
!.env.example

# --- Rahasia runtime (jangan pernah masuk git) ---
# Berisi password DB / kunci admin / rcon. Nilainya sudah ada di riwayat lama;
# lihat PLAN_GO_LIVE.md bagian rotasi kunci.
scriptfiles/mysql.ini
scriptfiles/admin_keys.cfg
runtime/*/mysql.ini
runtime/*/server.cfg
runtime/*/scriptfiles/admin_keys.cfg
backups/

# --- Artefak build & log ---
# main.amx dihasilkan scripts/build.sh; menyimpannya di git membuat setiap
# build menghasilkan diff 9 MB dan biner basi bisa ikut ter-deploy.
gamemodes/*.amx
runtime/*/server_log.txt
runtime/*/console.log
runtime/*/scriptfiles/logs/
pawn.lock
mysql.ini
server.cfg
filterscripts/
npcmodes/
sampctl_build_file.inc
server_log.txt
runtime/*/console.log
runtime/*/scriptfiles/logs/

# Snapshot internal tooling agen (stash file biner), bukan hasil kerja proyek.
.freebuff-snapshots/

# Preview HUD dihasilkan tools/hud_preview/generate.py untuk dilihat mata, bukan sumber.
tools/hud_preview/generate.html
tools/hud_preview/build_panel.html
backups/preview/
__pycache__/

# --- Log & crash dump runtime (jangan pernah masuk git) ---
runtime/*/logs/
runtime/*/*.log
runtime/*/fcnpc-crash_*.txt
runtime/*/crashinfo*
runtime/soak/
